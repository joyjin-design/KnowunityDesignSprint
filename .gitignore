# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/css/
!/build/css/**

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local skill cache (except the project's own build-screen skill)
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/build-screen/

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
