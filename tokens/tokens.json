    "background": {
      "page": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Root screen canvas; use for every screen's base background."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.navy.800}",
        "$description": "Elevated container fill; use for cards, bottom sheets, modals, dropdown menus, chat bubbles, toasts."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.violet.50}",
        "$description": "Dark block on a light screen; use for tooltips, toasts, snackbars on light backgrounds."
      },
      "scrim": {
        "$type": "color",
        "$value": "{color.alpha.dark-50}",
        "$description": "Semi-transparent overlay dimming content behind a modal; use for behind modals, dialogs, bottom sheets."
      },
      "floating": {
        "$type": "color",
        "$value": "{color.alpha.glass-60}",
        "$description": "Elevated floating surface with translucency; use for dropdown menus, tooltips, popovers that float above content with a frosted-glass effect."
      },
      "stacking": {
        "$type": "color",
        "$value": "{color.alpha.light-10}",
        "$description": "Additive white layer for stacking elevation on dark surfaces; use for toasts, snackbars, floating notifications that need subtle lift above dark backgrounds."
      },
      "input": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Fill of an editable field; use for text inputs, textareas, search fields at rest."
      }
    },
    "interactive": {
      "primary": {
        "$type": "color",
        "$value": "{color.violet.50}",
        "$description": "Main call-to-action fill; use for continue, Check, Start practice buttons, progress bar fills."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.alpha.light-10}",
        "$description": "Supporting action fill; use for skip, Cancel, filter chips, outlined buttons, toggles."
      },
      "destructive": {
        "$type": "color",
        "$value": "{color.red.400}",
        "$description": "Irreversible harmful action fill; use for delete, remove, block buttons."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.alpha.light-8}",
        "$description": "Non-interactive control fill signaling unavailable; use for disabled buttons, toggles, sliders."
      },
      "onPrimary": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Text and icons on interactive.primary fills; must contrast >= 4.5:1 against interactive.primary."
      },
      "onSecondary": {
        "$type": "color",
        "$value": "{color.violet.50}",
        "$description": "Text and icons on interactive.secondary fills; use for labels inside secondary buttons, toggle text, filter chip labels."
      },
      "pressed": {
        "$type": "color",
        "$value": "{color.alpha.light-10}",
        "$description": "Press overlay for light or vivid surfaces; use for tap feedback on primary buttons and elements sitting on accent fills."
      },
      "pressedInverse": {
        "$type": "color",
        "$value": "{color.alpha.dark-10}",
        "$description": "Press overlay for dark surfaces; use for tap feedback on secondary buttons, icon buttons, list items and cards on background.page or background.surface."
      },
      "primaryHover": {
        "$type": "color",
        "$value": "{color.violet.100}",
        "$description": "Hover state of interactive.primary; use for pointer hover on primary buttons."
      },
      "primaryActive": {
        "$type": "color",
        "$value": "{color.violet.200}",
        "$description": "Pressed state of interactive.primary; use for the moment of click or tap on a primary button."
      },
      "secondaryHover": {
        "$type": "color",
        "$value": "{color.alpha.light-18}",
        "$description": "Hover state of interactive.secondary; use for pointer hover on secondary buttons, chips and toggles."
      },
      "secondaryActive": {
        "$type": "color",
        "$value": "{color.alpha.light-24}",
        "$description": "Pressed state of interactive.secondary."
      },
      "destructiveHover": {
        "$type": "color",
        "$value": "{color.red.300}",
        "$description": "Hover state of interactive.destructive; use for pointer hover on delete and remove buttons."
      },
      "destructiveActive": {
        "$type": "color",
        "$value": "{color.red.500}",
        "$description": "Pressed state of interactive.destructive."
      },
      "onDestructive": {
        "$type": "color",
        "$value": "{color.red.950}",
        "$description": "Text and icons on interactive.destructive fills; must contrast >= 4.5:1 against interactive.destructive."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.violet.50}",
        "$description": "Highest contrast text for maximum readability; use for headlines, body copy, titles, card labels."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.alpha.light-68}",
        "$description": "Reduced emphasis text for supporting content; use for subtitles, captions, timestamps, helper text, metadata."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Dark text on light or vivid surfaces; use for labels on background.inverse, text on bright accent fills."
      },
      "link": {
        "$type": "color",
        "$value": "{color.violet.500}",
        "$description": "Inline hyperlink text only; use for linked text in body copy, T&C links, Learn more inline links."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.alpha.light-40}",
        "$description": "Low-contrast text signaling unavailable or not yet filled; use for text on disabled controls, placeholder text in empty input fields."
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.alpha.light-48}",
        "$description": "Lowest emphasis readable text; use for timestamps, counts, inline hints beside a field."
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.violet.300}",
        "$description": "Hover state of text.link; use for pointer hover on inline hyperlinks."
      },
      "success": {
        "$type": "color",
        "$value": "{color.green.300}",
        "$description": "Confirmation text; use for correct, validation success messages."
      },
      "error": {
        "$type": "color",
        "$value": "{color.red.200}",
        "$description": "Validation message text; use for the line under a failed field."
      },
      "warning": {
        "$type": "color",
        "$value": "{color.gold.300}",
        "$description": "Caution text; use for limits, expiry notices, one attempt left."
      },
      "onAccent": {
